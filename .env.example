# ---------------------------------------------------------------------------
# Rollbit — variables d'environnement
# Copiez ce fichier vers `.env.local` (ou `.env.development.local` en dev)
# puis renseignez vos valeurs. Ne committez jamais de vrai secret.
# ---------------------------------------------------------------------------

# --- Service wallet (chiffrement au repos AES-256-GCM) ----------------------
# Clé maître hexadécimale de 32 octets (64 caractères hex).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : doit rester stable. Sans elle, les wallets stockés sont illisibles.
MASTER_ENCRYPTION_KEY=

# Sel HKDF utilisé pour dériver une clé par propriétaire (ownerId).
WALLET_KEY_SALT=rollbit-wallet-v1

# Dossier de stockage local du magasin chiffré (fichier wallets.json, mode 0600).
WALLET_STORE_PATH=./data

# Persister le magasin sur disque. false = mémoire uniquement (serverless/éphémère).
WALLET_PERSIST=true

# Exiger une phrase secrète utilisateur pour créer ET révéler un wallet.
WALLET_REQUIRE_PASSPHRASE=false

# Longueur minimale de la phrase secrète quand elle est utilisée.
WALLET_MIN_PASSPHRASE_LENGTH=8

# Nombre maximum de wallets par propriétaire (ownerId).
WALLET_MAX_PER_OWNER=20

# --- Dépôts : adresses publiques de réception (clés publiques de la maison) --
# Clés PUBLIQUES uniquement (jamais de clés privées/phrases ici). Elles sont
# affichées aux visiteurs dans la fenêtre « Dépôt » pour recevoir leurs fonds.
ETHEREUM_TREASURY_ADDRESS=
BITCOIN_TREASURY_ADDRESS=
SOLANA_TREASURY_ADDRESS=

# Marge de la maison en points de base appliquée aux gains (200 = 2 %).
# Borné entre 0 et 2000 (20 %). Une marge faible garde le jeu attractif tout
# en garantissant un espérance de gain positive pour le casino.
HOUSE_EDGE_BPS=200

# Frais de service prélevés sur les dépôts en points de base (100 = 1 %).
SERVICE_FEE_BPS=100

# --- Analytics (optionnel) --------------------------------------------------
# Activé automatiquement en production via @vercel/analytics.

# --- Monetag / publicité (miroir du repo v0-web-iptv-player-private) ---------
# Activer la monétisation (push overlay iframe + retour /api/ads/shown).
NEXT_PUBLIC_MONETAG_ENABLED=false

# Lien publicitaire direct (iframe incrustée / push). Ex : uplcm/omg10.
NEXT_PUBLIC_MONETAG_AD_LINK=https://uplcm.com/4/11934306

# MultiTag (popunder/vignette/popup) : charger UNIQUEMENT sur le push, pas au
# lancement. Laisser vide si non utilisé.
NEXT_PUBLIC_MONETAG_TAG_SRC=
NEXT_PUBLIC_MONETAG_ZONE=

# Rediriger les bots/crawlers (User-Agent) vers le lien publicitaire (302,
# uniquement sur l'accueil). Vide = désactivé.
BOT_REDIRECT_URL=

# --- Telegram (optionnel) ---------------------------------------------------
# Notifications du casino (dépôts, retraits, wallets) + commandes d'admin.
# Chats multiples autorisés : séparés par des virgules.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL publique du site (sans "/api/telegram") pour enregistrer le webhook.
# Si absent, on tente VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
TELEGRAM_WEBHOOK_URL=

# Secret optionnel envoyé comme en-tête X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
