# ---------------------------------------------------------------------------
# Live Roll — variables d'environnement
# Copiez ce fichier vers `.env.local` (ou `.env.development.local` en dev)
# puis renseignez vos valeurs. Ne committez jamais de vrai secret.
#
# Architecture : Solana uniquement, non-custodial. Les signatures sont faites
# côté joueur (wallet navigateur Phantom). Le serveur ne détient AUCUNE clé
# privée : il construit les transactions, interroge les RPC (solde, frais) et
# relaie les transactions déjà signées.
# ---------------------------------------------------------------------------

# --- Solana (réseau unique) -------------------------------------------------
# URL RPC Solana. Le serveur l'utilise pour le solde, les frais et la diffusion.
# Mainnet : https://api.mainnet-beta.solana.com
# Devnet  : https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Cluster explicite (mainnet-beta | devnet | testnet | localnet). Déduit de
# SOLANA_RPC_URL si vide.
SOLANA_NETWORK=

# Adresse PUBLIQUE de réception des mises (trésorerie de la maison).
# Clé publique uniquement — jamais de clé privée ici.
SOLANA_TREASURY_ADDRESS=

# Prix de priorité optionnel en micro-lamports par unité de calcul (0 = aucun).
# Ex : 10000 pour accélérer la confirmation en période de congestion.
SOLANA_PRIORITY_FEE_MICROLAMPORTS=0

# Autoriser la diffusion des transactions signées (false = mode lecture seule).
SOLANA_SEND_ENABLED=true

# Délai RPC en millisecondes.
SOLANA_RPC_TIMEOUT_MS=20000

# Marge de la maison en points de base appliquée aux gains (200 = 2 %).
# Borné entre 0 et 2000 (20 %). Une marge faible garde le jeu attractif tout
# en garantissant une espérance de gain positive pour le casino.
HOUSE_EDGE_BPS=200

# --- Analytics (optionnel) --------------------------------------------------
# Activé automatiquement en production via @vercel/analytics.

# --- Monetag / publicité (miroir du repo v0-web-iptv-player-private) ---------
# Activer la monétisation (push overlay iframe + retour /api/ads/shown).
NEXT_PUBLIC_MONETAG_ENABLED=false

# Lien publicitaire direct (iframe incrustée / push). Ex : uplcm/omg10.
NEXT_PUBLIC_MONETAG_AD_LINK=https://uplcm.com/4/11934306

# MultiTag (popunder/vignette/popup) : charger UNIQUEMENT sur le push, pas au
# lancement. Laisser vide si non utilisé.
NEXT_PUBLIC_MONETAG_TAG_SRC=
NEXT_PUBLIC_MONETAG_ZONE=

# Rediriger les bots/crawlers (User-Agent) vers le lien publicitaire (302,
# uniquement sur l'accueil). Vide = désactivé.
BOT_REDIRECT_URL=

# --- Telegram (optionnel) ---------------------------------------------------
# Notifications du casino (mises on-chain) + commandes d'admin.
# Chats multiples autorisés : séparés par des virgules.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL publique du site (sans "/api/telegram") pour enregistrer le webhook.
# Si absent, on tente VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
TELEGRAM_WEBHOOK_URL=

# Secret optionnel envoyé comme en-tête X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
